---
import InternalLayout from '../../layouts/InternalLayout.astro';
import { applyUrl, contactInfo } from '../../data/site';

// Calendly embeds fine as a plain iframe, so we skip their widget.js and the
// third-party script it drags along.
const embedSrc = applyUrl
  ? `${applyUrl}${applyUrl.includes('?') ? '&' : '?'}embed_type=Inline&hide_gdpr_banner=1`
  : null;
---

<InternalLayout
  title="Start a Program"
  description="Book a short call to see whether one of our programs is the right fit for where you are."
  noindex
  hideBookingCtas
  current="programs"
>
  <section class="apply">
    <p class="i-eyebrow"><span></span>Programs</p>
    <h1>Let’s see if this is a fit.</h1>
    <p class="apply-blurb">
      A short call with a doctor — no exam, no commitment. We’ll ask what’s going on, tell you
      honestly whether a program makes sense for you, and what it would actually take.
    </p>

    {embedSrc ? (
      <div class="apply-embed">
        <iframe src={embedSrc} title="Program intake call scheduler"></iframe>
      </div>
    ) : (
      <div class="apply-fallback">
        <p>Online scheduling for program calls isn’t live yet — call the studio and we’ll set it up.</p>
        <a class="i-btn h-btn-primary" href={contactInfo.phoneHref}>Call {contactInfo.phone}</a>
      </div>
    )}

    <p class="apply-help">
      Just want a single appointment instead? <a href="/book/">Book a visit</a>.
    </p>
  </section>
</InternalLayout>

<style>
  .apply {
    max-width: 1000px;
    margin: 0 auto;
    padding: 56px 32px 72px;
  }
  .apply h1 {
    font-family: 'Fraunces', serif;
    font-weight: 400;
    font-size: clamp(36px, 4.8vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #483e5e;
    margin: 0 0 18px;
  }
  .apply-blurb {
    font-size: 18px;
    line-height: 1.62;
    color: #194247;
    opacity: 0.9;
    max-width: 34em;
    margin: 0 0 40px;
  }
  .apply-embed iframe {
    border: none;
    width: 100%;
    height: 740px;
    display: block;
  }
  .apply-fallback {
    background: #e2dce2;
    border-radius: 12px;
    padding: 40px 32px;
    text-align: center;
  }
  .apply-fallback p {
    font-size: 17px;
    line-height: 1.55;
    color: #194247;
    margin: 0 0 24px;
  }
  .apply-help {
    font-size: 15px;
    color: #194247;
    opacity: 0.8;
    margin: 32px 0 0;
  }
  .apply-help a {
    color: #483e5e;
    font-weight: 600;
  }
  @media screen and (max-width: 750px) {
    .apply {
      padding: 40px 24px 56px;
    }
    .apply-embed iframe {
      height: 1000px;
    }
  }
</style>
