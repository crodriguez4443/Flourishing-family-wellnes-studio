---
import InternalLayout from '../../layouts/InternalLayout.astro';
import { bookingCalendars, contactInfo } from '../../data/site';

// Program intake calls all route through the acupuncture calendar (Dr.
// Alexandra), regardless of which program the visitor came from.
const acupuncture = bookingCalendars.find((entry) => entry.slug === 'acupuncture');
const skedSrc = acupuncture?.skedKey
  ? `https://portal.sked.life/new-patient?key=${acupuncture.skedKey}`
  : null;
---

<InternalLayout
  title="Start a Program"
  description="Book a short call to see whether one of our programs is the right fit for where you are."
  noindex
  hideBookingCtas
  current="programs"
>
  <section class="apply">
    <p class="i-eyebrow"><span></span>Programs</p>
    <h1>Let’s see if this is a fit.</h1>
    <p class="apply-blurb">
      A short call with a doctor — no exam, no commitment. We’ll ask what’s going on, tell you
      honestly whether a program makes sense for you, and what it would actually take.
    </p>

    {skedSrc ? (
      <div class="sked-portal-container">
        <iframe
          id="sked-portal"
          title="Program intake call scheduler"
          sandbox="allow-top-navigation allow-scripts allow-forms allow-same-origin allow-popups"
          src={skedSrc}
        ></iframe>
      </div>
    ) : (
      <div class="apply-fallback">
        <p>Online scheduling for program calls isn’t live yet — call the studio and we’ll set it up.</p>
        <a class="i-btn h-btn-primary" href={contactInfo.phoneHref}>Call {contactInfo.phone}</a>
      </div>
    )}

    <p class="apply-help">
      Just want a single appointment instead? <a href="/book/">Book a visit</a>.
    </p>
  </section>
</InternalLayout>

<script is:inline>
  // Sked posts a redirect URL to the parent once an appointment is confirmed.
  // Only trust messages coming from the portal itself — without the origin
  // check any page could navigate this tab anywhere.
  window.addEventListener('message', function (event) {
    if (event.origin !== 'https://portal.sked.life') return;
    try {
      const message = JSON.parse(event.data);
      if (message && message.url) window.location.href = message.url;
    } catch (err) {}
  });
</script>

<style>
  .apply {
    max-width: 1000px;
    margin: 0 auto;
    padding: 56px 32px 72px;
  }
  .apply h1 {
    font-family: var(--font-fraunces), serif;
    font-weight: 400;
    font-size: clamp(36px, 4.8vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #483e5e;
    margin: 0 0 18px;
  }
  .apply-blurb {
    font-size: 18px;
    line-height: 1.62;
    color: #194247;
    opacity: 0.9;
    max-width: 34em;
    margin: 0 0 40px;
  }
  /* Aspect ratios supplied by Sked — their form gets dramatically taller on
     narrow screens, hence the 310%. */
  .sked-portal-container {
    position: relative;
    overflow: hidden;
    width: 100%;
    padding-top: 60%;
  }
  .sked-portal-container iframe {
    border: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .apply-fallback {
    background: #e2dce2;
    border-radius: 12px;
    padding: 40px 32px;
    text-align: center;
  }
  .apply-fallback p {
    font-size: 17px;
    line-height: 1.55;
    color: #194247;
    margin: 0 0 24px;
  }
  .apply-help {
    font-size: 15px;
    color: #194247;
    opacity: 0.8;
    margin: 32px 0 0;
  }
  .apply-help a {
    color: #483e5e;
    font-weight: 600;
  }
  @media screen and (max-width: 900px) {
    .sked-portal-container {
      padding-top: 100%;
    }
  }
  @media screen and (max-width: 750px) {
    .apply {
      padding: 40px 24px 56px;
    }
    .sked-portal-container {
      padding-top: 310%;
    }
  }
</style>
