---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHeader from './SectionHeader.astro';
import { doctors as defaultDoctors } from '../data/site';

interface Doctor {
  name: string;
  role: string;
  image: string;
  bio: string;
}

interface Props {
  doctors?: Doctor[];
  id?: string;
  band?: boolean;
  eyebrow?: string;
  title?: string;
  titleHtml?: string;
  text?: string;
  linkHref?: string;
  linkLabel?: string;
}

const {
  doctors = defaultDoctors,
  id,
  band = false,
  eyebrow = 'Meet your doctors',
  title = "The people you'll actually see.",
  titleHtml,
  text = "Same faces every time. The doctor you meet on day one is the one who's still with you a year later.",
  linkHref,
  linkLabel = 'Read our story',
} = Astro.props;

const optimizedImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const resolveImage = (path: string) => optimizedImages[`/src${path}`]?.default;
---

<section id={id} class={`meet-doctors ${band ? 'meet-doctors-band' : ''} r-sect r-pad-lg`}>
  <div class="meet-doctors-inner">
    <div class="meet-doctors-head">
      <SectionHeader eyebrow={eyebrow} title={title} titleHtml={titleHtml} text={text} maxWidth="30em" />
      {linkHref && <a href={linkHref} class="h-link-underline">{linkLabel}&nbsp;→</a>}
    </div>

    <div class="meet-doctors-grid">
      {doctors.map((doctor, index) => {
        const optimizedImage = resolveImage(doctor.image);
        return (
          <article class="meet-doctor">
            <div class={`meet-doctor-image meet-doctor-image-${index % 3}`}>
              {optimizedImage ? (
                <Image src={optimizedImage} alt={doctor.name} widths={[280, 420, 560, 720]} sizes="(max-width: 940px) calc(100vw - 84px), 31vw" format="webp" quality="high" loading="lazy" decoding="async" />
              ) : (
                <Image src={doctor.image} alt={doctor.name} inferSize widths={[280, 420, 560, 720]} sizes="(max-width: 940px) calc(100vw - 84px), 31vw" format="webp" quality="high" loading="lazy" decoding="async" />
              )}
            </div>
            <h3>{doctor.name}</h3>
            <div class="meet-doctor-role">{doctor.role}</div>
            <p>{doctor.bio}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
